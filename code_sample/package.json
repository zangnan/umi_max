{
  "name": "ant-design-pro",
  "version": "5.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "scripts": {
    "dev:desktop": "cross-env APP_TYPE=desktop_dev electron ./app",
    "build:d": "cross-env APP_TYPE=desktop electron-builder --win",
    "build:desktop": "cross-env APP_TYPE=desktop npm run build && electron-builder --win",
    "analyze": "cross-env ANALYZE=1 umi build",
    "build": "umi build",
    "build:dev": "cross-env build_env=dev umi build",
    "build:test": "cross-env build_env=test umi build",
    "build:dem": "cross-env build_env=dem umi build",
    "build:pro": "cross-env build_env=pro umi build",
    "build:ls": "cross-env build_env=ls umi build",
    "build:sztest": "cross-env build_env=sztest JC_TYPE=ckts umi build",
    "build:szdem": "cross-env build_env=szdem JC_TYPE=ckts umi build",
    "build:szpro": "cross-env build_env=szpro JC_TYPE=ckts umi build",
    "build:relpath": "cross-env build_env=relpath umi build",
    "build:relpathTheme04": "cross-env build_env=relpath THEME_TYPE=theme04 umi build",
    "build:jcrelpath": "cross-env build_env=jcRelpath JC_TYPE=ckts umi build",
    "build:jcrelpathTheme04": "cross-env build_env=jcRelpath JC_TYPE=ckts THEME_TYPE=theme04 umi build",
    "build:relpathPro": "cross-env build_env=relpath DZSWJ_ADDRESS=pro umi build ",
    "build:relpathTest": "cross-env build_env=relpath DZSWJ_ADDRESS=test umi build ",
    "build:relpathTheme04Pro": "cross-env build_env=relpath THEME_TYPE=theme04 DZSWJ_ADDRESS=pro umi build",
    "build:relpathTheme04Test": "cross-env build_env=relpath THEME_TYPE=theme04 DZSWJ_ADDRESS=test umi build",
    "build:jcrelpathPro": "cross-env build_env=jcRelpath DZSWJ_ADDRESS=pro umi build ",
    "build:jcrelpathTest": "cross-env build_env=jcRelpath DZSWJ_ADDRESS=test umi build ",
    "build:jcrelpathTheme04Pro": "cross-env build_env=jcRelpath THEME_TYPE=theme04 DZSWJ_ADDRESS=pro umi build",
    "build:jcrelpathTheme04Test": "cross-env build_env=jcRelpath THEME_TYPE=theme04 DZSWJ_ADDRESS=test umi build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "umi g tmp",
    "lint": "umi g tmp && npm run lint:js && npm run lint:style && npm run lint:prettier && npm run tsc",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js,.jsx,.ts,.tsx ",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src && npm run lint:style",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c --write \"src/**/*\" --end-of-line auto",
    "lint:style": "stylelint --fix \"src/**/*.less\" --syntax less",
    "openapi": "umi openapi",
    "precommit": "lint-staged",
    "prettier": "prettier -c --write \"src/**/*\"",
    "serve": "umi-serve",
    "start": "SET NODE_OPTIONS=--openssl-legacy-provider && cross-env PORT=8866 UMI_ENV=dev COMPRESS=none umi dev",
    "start:dev": "cross-env REACT_APP_ENV=dev MOCK=none UMI_ENV=dev umi dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev umi dev",
    "start:no-ui": "cross-env UMI_UI=none UMI_ENV=dev umi dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev umi dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev umi dev",
    "start:dev2": "SET NODE_OPTIONS=--openssl-legacy-provider && cross-env PORT=8866 UMI_ENV=dev COMPRESS=none umi dev",
    "pretest": "node ./tests/beforeTest",
    "test": "umi test",
    "test:all": "node ./tests/run-tests.js",
    "test:component": "umi test ./src/components",
    "tsc": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.less": "stylelint --syntax less",
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/charts": "^1.3.2",
    "@ant-design/icons": "^4.5.0",
    "@ant-design/pro-card": "^1.18.14",
    "@ant-design/pro-descriptions": "^1.10.20",
    "@ant-design/pro-form": "1.70.0",
    "@ant-design/pro-layout": "6.31.7",
    "@ant-design/pro-table": "^2.61.2",
    "@umijs/hooks": "^1.9.3",
    "@umijs/route-utils": "^2.0.4",
    "antd": "4.19.5",
    "classnames": "^2.2.6",
    "codemirror": "^5.65.0",
    "immutability-helper": "^3.1.1",
    "js-base64": "^3.7.2",
    "lodash": "^4.17.11",
    "moment": "^2.25.3",
    "numeral": "^2.0.6",
    "omit.js": "^2.0.2",
    "rc-menu": "^9.0.13",
    "rc-util": "^5.16.1",
    "react": "^17.0.0",
    "react-codemirror2": "^7.2.1",
    "react-copy-to-clipboard": "^5.0.4",
    "react-custom-scrollbars": "^4.2.1",
    "react-dev-inspector": "^1.7.1",
    "react-dnd": "^14.0.4",
    "react-dnd-html5-backend": "^14.0.2",
    "react-dom": "^17.0.0",
    "react-helmet-async": "^1.2.2",
    "react-infinite-scroll-component": "^6.1.0",
    "react-json-view": "^1.21.3",
    "react-sortable-hoc": "^2.0.0",
    "react-split-pane": "^0.1.92",
    "react-window": "^1.8.6",
    "umi": "^3.5.0",
    "umi-plugin-keep-alive": "^0.0.1-beta.29",
    "umi-serve": "^1.9.10",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^2.0.2",
    "@types/express": "^4.17.0",
    "@types/history": "^4.7.2",
    "@types/jest": "^27.0.3",
    "@types/lodash": "^4.14.178",
    "@types/react": "^17.0.37",
    "@types/react-dom": "^17.0.11",
    "@types/react-helmet": "^6.1.0",
    "@types/react-window": "^1.8.5",
    "@umijs/fabric": "^2.6.2",
    "@umijs/openapi": "^1.3.9",
    "@umijs/plugin-blocks": "^2.0.5",
    "@umijs/plugin-esbuild": "^1.4.1",
    "@umijs/plugin-openapi": "^1.3.2",
    "@umijs/preset-ant-design-pro": "^1.2.0",
    "@umijs/preset-dumi": "^1.1.37",
    "@umijs/preset-react": "^2.1.0",
    "@umijs/yorkie": "^2.0.3",
    "carlo": "^0.9.46",
    "cross-env": "^7.0.0",
    "cross-port-killer": "^1.1.1",
    "detect-installer": "^1.0.1",
    "enzyme": "^3.11.0",
    "eslint": "^8.5.0",
    "express": "^4.17.2",
    "gh-pages": "^3.0.0",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^12.1.3",
    "mockjs": "^1.0.1-beta3",
    "prettier": "^2.5.1",
    "puppeteer-core": "^13.0.0",
    "stylelint": "^14.1.0",
    "swagger-ui-react": "^4.1.3",
    "typescript": "^4.5.4",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=10.0.0"
  },
  "gitHooks": {
    "commit-msg": "fabric verify-commit"
  }
}
