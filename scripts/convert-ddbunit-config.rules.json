{
  "prependImports": [
    "import CONSTANTS from '@/components/DDAssist/constants';"
  ],
  "removeImports": [
    "import myUtil from '@/pages/common/myUtil';"
  ],
  "renames": {
    "unit_key": "module_key",
    "click_checked": "grid_click_checked",
    "costomer_toobar": "customer_toolbar",
    "grid_show_data_num": "toolbar_show_grid_checked_num"
  },
  "toolbarRenames": {
    "tssb_download": "download"
  },
  "removes": [],
  "preserveKeys": {
    "layout_type": "tz"
  },
  "header": {
    "referenceFile": "src/pages/example/json_page/unit/config.tsx",
    "protocolFile": "src/components/DDBunit/DDBunit2.types.ts"
  },
  "route": {
    "enabled": true,
    "cktsFile": "config/routes/routes.ckts.ts",
    "nameMapping": {
      "monthData": "月度计划",
      "seasonData": "季度计划",
      "yearData": "年度计划"
    },
    "pathTemplate": "/hts/saasMdt/tuiShuiJiHua/{basename}",
    "_pathTemplateNote": "r9 起 path/component 默认从 outPath 反向派生；pathTemplate 仅在 outPath 不可派生时作为回退使用。保留此字段仅为向后兼容历史 fixture 和脚本。"
  },
  "replace": {
    "ts": [
      {
        "old": "如10-13+14>0则为10-13+14",
        "new": "如10-13+14&gt;0则为10-13+14"
      },
      {
        "old": "如15>17则为17",
        "new": "如15&gt;017则为17"
      },
      {
        "old": "routeMatch.path",
        "new": "routeMatch.route.path"
      },
      {
        "old": "myUtil.sys.enterpriseType()",
        "new": "cktsUtil.sys.enterpriseType()"
      },
      {
        "old": "baseValidator.email()",
        "new": "{type: 'email'}"
      },
      {
        "old": ".grid_api_grid_query",
        "new": ".api_grid_query"
      },
      {
        "old": "${API_URL_BASE}",
        "new": ""
      }
    ],
    "less": []
  },
  "special": [
    {
      "fileName": "code_sample/src/pages/hts/ckts/sbsjcx/sbsjcx.tsx",
      "replace": [
        {
          "old": "useEffect(() => {",
          "new": ""
        },
        {
          "old": "}, []);",
          "new": ""
        },
        {
          "old": "<DDBunit2 config={myConfig} func={Func} />",
          "new": "<DDBunit2 config={config} func={Func} />"
        },
        {
          "old": "const [myConfig, setMyConfig] = useState<any>(null);",
          "new": ""
        },
        {
          "old": "setMyConfig(config);",
          "new": ""
        }
      ]
    }
  ]
}